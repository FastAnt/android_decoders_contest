# Local media: source audio, tokens, decoded WAVs, images and videos
/media/

# Model weights and exported assets are not stored in Git.
# See models/README.md, decoder_cpp/models/README.md and the assets READMEs.
/models/*
!/models/README.md
/decoder_cpp/models/*
!/decoder_cpp/models/README.md
/client_android/assets/spectrostream/*.tflite
/client_android/assets/spectrostream/*.f32
/client_android/assets/spectrostream/*.npy
/client_android/assets/spectrostream/*.pb
/client_android/assets/sage/*.tflite
/client_android/assets/sage/*.f32
/client_android/assets/sage/*.npy
/client_android/assets/sage/*.pb

# External sources and intermediate model exports
/third_party/
/decoder_cpp/third_party/

