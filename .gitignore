# Local media: source audio, tokens, decoded WAVs, images and videos
/media/

# Original SpectroStream weights; ignore download metadata and other caches
/models/*
!/models/magenta_rt_cache/
/models/magenta_rt_cache/*
!/models/magenta_rt_cache/assets/
/models/magenta_rt_cache/assets/*
!/models/magenta_rt_cache/assets/savedmodels/
/models/magenta_rt_cache/assets/savedmodels/*
!/models/magenta_rt_cache/assets/savedmodels/ssv2_48k_stereo/

# External sources and intermediate model exports
/third_party/
/decoder_cpp/models/*
!/decoder_cpp/models/spectrostream_decoder_core_*.tflite
!/decoder_cpp/models/rvq_codebooks.f32
!/decoder_cpp/models/rvq_codebooks.npy
!/decoder_cpp/models/istft_window_f960.f32
!/decoder_cpp/models/istft_window_f960.npy
/decoder_cpp/third_party/
/client_android/assets/spectrostream/*.tflite
!/client_android/assets/spectrostream/spectrostream_decoder_core_*.tflite
/client_android/assets/spectrostream/*.f32
!/client_android/assets/spectrostream/rvq_codebooks.f32
!/client_android/assets/spectrostream/istft_window_f960.f32

# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# CMake, Flutter, Android and native build artifacts
build/
build-*/
.cxx/
.gradle/
.kotlin/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
*.o
*.a
*.so
*.so.*
*.apk
*.aab
coverage/

